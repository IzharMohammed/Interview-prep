generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(cuid())
  email    String    @unique
  password String

  expense  Expense[]
  categories Category[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal
  description String
  date        DateTime

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId     String
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   String @id @default(cuid())
  name String

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  expenses Expense[]

  @@unique([userId, name])
}
